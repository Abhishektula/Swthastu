{
  "name": "swthastu-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-production.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:next": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "preview:worker": "wrangler dev --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76",
    "@opennextjs/cloudflare": "1.20.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
