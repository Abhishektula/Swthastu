{
  "name": "swthastu-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "pnpm install --frozen-lockfile",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "build:cloudflare": "node --import ./scripts/sites-env.mjs ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "preview": "pnpm build:cloudflare && node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.jsonc --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern .open-next --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/state",
    "db:migrate:remote": "node scripts/cloudflare-cli.mjs migrate",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verify-wellbeing.mjs && node scripts/tests/run.mjs && node scripts/verify-catalogue.mjs",
    "deploy:check": "node scripts/cloudflare-cli.mjs check",
    "deploy": "node scripts/cloudflare-cli.mjs deploy",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:production": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js deploy --dry-run --config wrangler.jsonc --outdir .sites-runtime/production && node scripts/verify-production.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
